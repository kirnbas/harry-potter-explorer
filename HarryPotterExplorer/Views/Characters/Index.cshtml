@model CharactersIndexViewModel
@{
    ViewData["Title"] = "Characters";
    ViewData["Description"] = "Search every witch, wizard and creature on record: house, patronus, wand and more.";
    var q = Model.Query;
    var result = Model.FirstPage;
}

<div class="shell">
    <header class="page-head">
        <p class="eyebrow">The school register</p>
        <h1>Characters</h1>
        <p>
            Every name the castle has on file, served from this application&rsquo;s own database.
            Search by name, alternate name or the actor who played them; narrow by house, species,
            role or fate. Scroll and the next page arrives on its own.
        </p>
    </header>

    <form class="filters" data-catalog-filters role="search">
        <div class="field grow">
            <label for="f-search">Search by name</label>
            <input id="f-search" type="search" name="search" value="@q.Search"
                   placeholder="Hermione, The Chosen One, Alan Rickman&hellip;" autocomplete="off" />
        </div>

        <div class="field">
            <label for="f-house">House</label>
            <select id="f-house" name="house">
                <option value="">Any house</option>
                @foreach (var house in Model.Facets.Houses)
                {
                    <option value="@house" selected="@(q.House == house)">@house</option>
                }
                <option value="unsorted" selected="@(q.House == "unsorted")">Unsorted</option>
            </select>
        </div>

        <div class="field">
            <label for="f-species">Species</label>
            <select id="f-species" name="species">
                <option value="">Any species</option>
                @foreach (var species in Model.Facets.Species)
                {
                    <option value="@species" selected="@(q.Species == species)">@species</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="f-role">Role</label>
            <select id="f-role" name="role">
                <option value="">Anyone</option>
                <option value="student" selected="@(q.Role == "student")">Students</option>
                <option value="staff" selected="@(q.Role == "staff")">Staff</option>
            </select>
        </div>

        <div class="field">
            <label for="f-status">Fate</label>
            <select id="f-status" name="status">
                <option value="">Either</option>
                <option value="alive" selected="@(q.Status == "alive")">Alive</option>
                <option value="deceased" selected="@(q.Status == "deceased")">Deceased</option>
            </select>
        </div>

        <div class="field">
            <label for="f-sort">Order</label>
            <select id="f-sort" name="sort">
                <option value="name" selected="@(q.Sort == "name")">By name</option>
                <option value="house" selected="@(q.Sort == "house")">By house</option>
                <option value="popular" selected="@(q.Sort == "popular")">Most collected</option>
            </select>
        </div>

        <button class="btn btn-ghost btn-sm" type="button" data-reset-filters>Clear</button>
        <noscript><button class="btn btn-sm" type="submit">Search</button></noscript>
    </form>

    <div class="result-line">
        <span data-catalog-status>
            @(result.TotalCount == 1 ? "1 character" : $"{result.TotalCount} characters")
        </span>
        <span class="small">Cards you keep are stored in this browser only.</span>
    </div>

    @if (Model.Sync.State is "syncing" && result.TotalCount == 0)
    {
        <div class="notice">
            <span aria-hidden="true">🦉</span>
            <div>The register is still being copied from the public API. Give the owls a minute and refresh.</div>
        </div>
    }

    <div class="grid"
         data-character-grid
         data-cards-endpoint="/characters/cards"
         data-page="@result.Page"
         data-has-more="@(result.HasMore ? "true" : "false")">
        @if (result.Items.Count == 0)
        {
            <div class="notice empty" style="grid-column:1/-1">
                Not a single portrait matches that. Try a different name or clear the filters.
            </div>
        }
        else
        {
            <partial name="_CharacterCards" model="result.Items" />
        }
    </div>

    <div class="sentinel" data-sentinel aria-hidden="true"></div>

    @if (result.HasMore)
    {
        <p class="center" style="margin-top:1.5rem">
            <button class="btn" type="button" data-load-more>Summon more cards</button>
        </p>
    }

    <noscript>
        <p class="notice" style="margin-top:1.5rem">
            JavaScript is off, so infinite scroll is unavailable. The filter form still works
            with the <strong>Search</strong> button, and every card links to a full page.
        </p>
    </noscript>
</div>

<div class="visually-hidden" role="status" aria-live="polite" data-live-region></div>
